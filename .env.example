# Solar Tracking System — environment variable reference
# Copy this to .env and fill in your values

# --- Device Identity ---
# The device ID this backend expects telemetry from.
# Default: solar-tracker-01
SOLAR_DEVICE_ID=solar-tracker-01

# --- Presence / Timeouts ---
# Seconds of silence before the device is marked offline.
# Default: 10
SOLAR_OFFLINE_AFTER=10

# Seconds before a PENDING command is auto-expired.
# Default: 60
SOLAR_COMMAND_EXPIRE=60

# --- Security ---
# Required shared secret. All protected API requests must include:
# X-API-Key: <value>
# Generate a random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SOLAR_API_KEY=replace-this-with-a-long-random-secret

# Optional SQLite file location. Defaults to backend/solar_tracker.db.
# SOLAR_DB_PATH=backend/solar_tracker.db
