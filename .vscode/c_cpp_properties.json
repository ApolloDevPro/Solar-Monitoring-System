{
  "configurations": [
    {
      "name": "Arduino AVR",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:LOCALAPPDATA}/Arduino15/libraries/Servo/src",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/*/cores/arduino",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/*/variants/**",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/avr-gcc/*/avr/include",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/avr-gcc/*/lib/gcc/avr/*/include"
      ],
      "defines": [
        "ARDUINO=10819",
        "ARDUINO_ARCH_AVR",
        "ARDUINO_AVR_UNO",
        "F_CPU=16000000L"
      ],
      "compilerPath": "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin/avr-g++.exe",
      "compilerArgs": [
        "-mmcu=atmega328p"
      ],
      "cStandard": "gnu11",
      "cppStandard": "gnu++11",
      "intelliSenseMode": "windows-gcc-x64"
    }
  ],
  "version": 4
}
